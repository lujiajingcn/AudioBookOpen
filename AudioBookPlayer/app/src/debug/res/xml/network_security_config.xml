<?xml version="1.0" encoding="utf-8"?>
<!-- Debug 构建专用（覆盖 src/main 下的同名资源）：
     本地开发常需连接局域网内临时搭建的 HTTP 服务（如 http://192.168.x.x:8080），
     无法提前枚举这些地址，因此 debug 包放开明文 HTTP。
     Release 包不包含本资源，走 src/main 的严格配置（禁止明文）。 -->
<network-security-config>
    <debug-overrides>
        <trust-anchors>
            <!-- 信任用户安装的 CA（调试抓包/自签证书用） -->
            <certificates src="user" />
            <certificates src="system" />
        </trust-anchors>
    </debug-overrides>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
