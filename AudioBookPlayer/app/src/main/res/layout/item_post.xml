<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="12dp"
    android:background="?android:attr/selectableItemBackground">

    <!-- 头部：头像 + 用户名/时间 + 「更多」。
         「更多」取代了原先常驻的「举报」按钮：一枚 11sp 的红字按钮长在每张卡片右上角，
         既抢视觉重心，又对自己的帖子也能点（等于允许举报自己）。现在举报/删除都收进
         这个溢出菜单里，按「是不是我的帖子」给不同项。 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvPostAvatar"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:gravity="center"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:includeFontPadding="false"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvPostUsername"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="用户名"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@android:color/primary_text_light"
                android:ellipsize="end"
                android:maxLines="1" />

            <TextView
                android:id="@+id/tvPostTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="12sp"
                android:textColor="@android:color/secondary_text_dark"
                android:ellipsize="end"
                android:maxLines="1" />

        </LinearLayout>

        <TextView
            android:id="@+id/btnPostMore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="36dp"
            android:gravity="center"
            android:padding="8dp"
            android:text="⋮"
            android:textSize="18sp"
            android:textColor="@android:color/secondary_text_dark"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="更多操作" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvPostTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@android:color/primary_text_light"
        android:layout_marginTop="4dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvPostContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="15sp"
        android:textColor="@android:color/primary_text_light"
        android:layout_marginTop="6dp" />

    <!-- 图片：动态填充（最多 3 张横向排列） -->
    <LinearLayout
        android:id="@+id/llPostImages"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp"
        android:visibility="gone" />

    <!-- 嵌入的分享参考音频卡片 -->
    <LinearLayout
        android:id="@+id/llRefAudio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@android:color/darker_gray"
        android:padding="8dp"
        android:layout_marginTop="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvRefAudio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="参考音频分享"
            android:textSize="13sp"
            android:textColor="@android:color/primary_text_light" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">

        <!-- 点赞：只表态，不进「我的收藏」列表（与收藏是两条互不影响的链路） -->
        <Button
            android:id="@+id/btnLikePost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="♡ 0"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnFavorite"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="收藏"
            android:textSize="12sp"
            android:layout_marginStart="4dp" />

        <TextView
            android:id="@+id/tvCommentCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="评论 0"
            android:textSize="12sp"
            android:textColor="@android:color/secondary_text_dark"
            android:layout_marginStart="16dp" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@android:color/darker_gray"
        android:layout_marginTop="12dp" />

</LinearLayout>
