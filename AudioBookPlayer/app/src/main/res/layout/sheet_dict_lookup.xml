<?xml version="1.0" encoding="utf-8"?><!--
  查词结果底部弹窗。

  刻意不用 ScrollView 包一层：BottomSheetDialog 自带可拖拽的滚动容器，
  内容再套一层滚动会出现「内外两层都能滚、手势互相打架」。

  结构：
    头部   单词 + 音标 + 标签（柯林斯星级 / 牛津核心 / 考试标签）
    主体   释义列表（DictionaryManager 已按字面量 \n 切分并去空，逐条显示）
    底部   释义为空 / 未收录时的兜底文案
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="16dp"
    android:paddingBottom="20dp">

    <!-- 单词 + 音标 + 标签，同一行排不下时由下面的标签行单独折行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="true">

        <TextView
            android:id="@+id/tvWord"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary" />

        <TextView
            android:id="@+id/tvPhonetic"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:textSize="15sp"
            android:textColor="?android:attr/textColorSecondary" />

        <!--
          朗读按钮（2026-10-30 新增）：点一下重读这个单词。

          为什么需要它：点读本身**已经会自动朗读**（BookContentActivity.lookupAndShow
          → speakWordOrExplain），但那一句是「顺手就念了」，用户经常没听清
          （周围吵、正在想别的事、引擎起播慢），而弹窗弹出来之后**没有任何重放的入口** ——
          只能把弹窗关掉再点一次单词，或者干脆放弃。
          这个按钮把那句话变成可重复的动作，与自动朗读并存（不是替代）。

          位置：紧挨着单词/音标、在收藏按钮之前 —— 用户要重读时眼睛先落回单词上，
          按钮就在那儿；放释义下面会被长释义推到屏幕外（abandon 有 5+ 条义项），
          与收藏按钮当初挪上来的理由相同。

          ⚠️ 本工程没有现成的喇叭图标，ic_word_speak 是新建的；它的 fillColor 是白色占位，
          真正的颜色靠这里的 app:tint 给（浅色/夜间主题各自跟随）。见该 drawable 的注释。
        -->
        <ImageButton
            android:id="@+id/btnSpeakWord"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_word_speak"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="朗读这个单词"
            app:tint="?attr/colorPrimary" />

        <!--
          收藏按钮（单词本）：两态由「换 drawable」实现 ——
          未收藏 ic_word_book（灰星）、已收藏 ic_word_book_filled（琥珀星），
          见 DictLookupSheet.bindFavoriteButton。

          放头部行末尾、与音标同一行：释义列表可能很长（abandon 有 5+ 条义项），
          按钮若放底部会被长释义推到屏幕外、要点两次才看见。
          ImageButton 自带 selectableItemBackgroundBorderless，按钮语义由
          contentDescription 动态给（收藏该单词 / 取消收藏），无障碍朗读正确。
        -->
        <ImageButton
            android:id="@+id/btnFavoriteWord"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_word_book"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="收藏该单词" />
    </LinearLayout>

    <!-- 标签行：考试级别 / 柯林斯星级 / 牛津核心；没有标签时整行 GONE -->
    <TextView
        android:id="@+id/tvTags"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textSize="12sp"
        android:textColor="?android:attr/textColorSecondary"
        android:visibility="gone"
        tools:visibility="visible" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        android:background="?android:attr/listDivider" />

    <!-- 释义容器：每个词条一个 TextView，由代码动态添加 -->
    <LinearLayout
        android:id="@+id/llTranslations"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <!-- 词形变化：仅当该词条有 exchange 且能解析出中文标签时才显示 -->
    <TextView
        android:id="@+id/tvExchange"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textSize="12sp"
        android:textColor="?android:attr/textColorSecondary"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- 兜底：释义为空（词条存在但 ECDICT 没给中文释义） -->
    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="?android:attr/textColorSecondary"
        android:visibility="gone"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tvFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:textSize="11sp"
        android:textColor="?android:attr/textColorTertiary" />
</LinearLayout>