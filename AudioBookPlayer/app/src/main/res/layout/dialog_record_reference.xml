<?xml version="1.0" encoding="utf-8"?>
<!--
  录制参考音频的对话框（由参考音频管理页的「录制」按钮弹出）。

  从语音合成页搬过来时改了形态：那边是页面里常驻的一排小按钮（开始/停止/试听/删除），
  与本页的列表混在一起会显得很乱；这里改成对话框，录完即关闭，界面只在需要时出现。

  「完成」按钮由代码控制可用性（没录到文件时置灰），故不写 android:enabled。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="录制一段用于克隆音色的参考音频。建议在安静环境下录制 5~15 秒清晰人声。"
        android:textSize="14sp"
        android:textColor="?android:attr/textColorSecondary" />

    <TextView
        android:id="@+id/tvRecordStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="尚未开始"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnRecordStart"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="开始" />

        <Button
            android:id="@+id/btnRecordStop"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:text="停止"
            android:enabled="false" />

        <Button
            android:id="@+id/btnRecordDiscard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="删除"
            android:enabled="false" />

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="录完后点「保存」，这段音频会作为一条记录出现在「我的参考音频」里，之后在语音合成页就能选它。"
        android:textSize="12sp"
        android:textColor="?android:attr/textColorSecondary" />

</LinearLayout>
